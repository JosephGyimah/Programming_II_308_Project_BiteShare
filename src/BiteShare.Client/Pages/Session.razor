@page "/session/{SessionId:guid}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject AuthTokenStore Tokens
@inject OrderHubService Hub
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>BiteShare session</PageTitle>

<div class="bite-container">
    @if (Tokens.ParticipantToken is null || Tokens.SessionId != SessionId)
    {
        <div class="bite-body" style="padding-top:1.5rem;">
            <p class="bite-empty">You're not in this session yet. <a href="/">Go join or host one</a>.</p>
        </div>
    }
    else
    {
        <div class="bite-hero" style="padding:1.25rem 1.25rem 1.5rem;">
            <button class="bite-back-btn" @onclick='() => Nav.NavigateTo("/")'>←</button>
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div class="bite-brand" style="font-size:1.15rem;">🍱 BiteShare</div>
                    <p style="margin-top:.35rem;">@(Tokens.IsHost ? "You're hosting this table" : "You've joined this table")</p>
                </div>
                <span class="bite-badge status-@(_orderStatus?.ToLowerInvariant() ?? "open")">@(_orderStatus ?? "Open")</span>
            </div>
        </div>

        <div class="bite-body">
            @if (_reconnectBanner is not null)
            {
                <div class="bite-banner">⚠️ @_reconnectBanner</div>
            }

            @if (_orderStatus is not null)
            {
                <div class="bite-stepper">
                    @foreach (var s in StatusOrder)
                    {
                        var done = Array.IndexOf(StatusOrder, _orderStatus) >= Array.IndexOf(StatusOrder, s);
                        <div class="bite-step @(done ? "done" : "")">
                            <div class="bite-step-line"></div>
                            <div class="bite-step-dot">@(done ? "✓" : "")</div>
                            <div class="bite-step-label">@FriendlyStatus(s)</div>
                        </div>
                    }
                </div>
            }

            <div class="bite-section-title">
                Participants
                <span class="bite-code-pill">CODE — JOIN</span>
            </div>
            <div class="bite-avatar-row">
                @foreach (var p in _participants)
                {
                    <div class="bite-avatar">
                        <div class="bite-avatar-circle @(p.IsHost ? "host" : "")">@Initials(p.DisplayName)</div>
                        <span class="bite-avatar-name">@p.DisplayName</span>
                    </div>
                }
            </div>

            @if (Tokens.IsHost)
            {
                <div class="bite-card">
                    <h3>Add to the menu</h3>
                    <label class="bite-label">Item name</label>
                    <input placeholder="e.g. Chicken Fajita Pizza" @bind="_newItemName" />
                    <label class="bite-label">Price</label>
                    <input placeholder="0.00" @bind="_newItemPrice" />
                    <button class="secondary" @onclick="AddMenuItem">+ Add menu item</button>
                </div>
            }

            <div class="bite-section-title">Menu</div>
            @if (_menuItems.Any())
            {
                <div class="bite-menu-grid">
                    @foreach (var item in _menuItems)
                    {
                        <div class="bite-food-card">
                            <div class="bite-food-thumb">🍽️</div>
                            <div class="bite-food-name">@item.Name</div>
                            <div class="bite-food-desc">@(item.Description ?? "")</div>
                            <div class="bite-food-foot">
                                <span class="bite-food-price">$@item.Price.ToString("0.00")</span>
                                <button class="bite-add-btn" @onclick="() => AddToCart(item.Id)" disabled="@(_orderStatus is not null)">+</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bite-card">
                    <p class="bite-empty">@(Tokens.IsHost ? "Add a menu item above to get started." : "Waiting for the host to add menu items.")</p>
                </div>
            }

            <div class="bite-section-title">Shared cart</div>
            <div class="bite-card">
                @foreach (var item in _cart)
                {
                    <div class="bite-row">
                        <div class="bite-row-main">
                            <span class="bite-row-title">@item.MenuItemName</span>
                            <span class="bite-row-sub">@item.ParticipantName · x@item.Quantity</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:.6rem;">
                            <span class="bite-row-price">$@((item.UnitPrice * item.Quantity).ToString("0.00"))</span>
                            @if (item.ParticipantId == _myParticipantId && _orderStatus is null)
                            {
                                <button class="bite-icon-btn" @onclick="() => RemoveFromCart(item.Id)">✕</button>
                            }
                        </div>
                    </div>
                }
                @if (!_cart.Any())
                {
                    <p class="bite-empty">Nobody has added anything yet.</p>
                }
                else
                {
                    <div class="bite-summary-total">
                        <span>Subtotal</span>
                        <span>$@(_cart.Sum(c => c.UnitPrice * c.Quantity).ToString("0.00"))</span>
                    </div>
                }
            </div>

            @if (Tokens.IsHost && _orderStatus is null)
            {
                <div class="bite-section-title">Checkout</div>
                <div class="bite-card">
                    <label class="bite-label">Split mode</label>
                    <div class="bite-tabs" style="margin-bottom:.9rem;">
                        <button class="@(_splitMode == "Equal" ? "active" : "")" @onclick='() => _splitMode = "Equal"'>Split equally</button>
                        <button class="@(_splitMode == "PerItem" ? "active" : "")" @onclick='() => _splitMode = "PerItem"'>Split per item</button>
                    </div>

                    <label class="bite-label">Tax</label>
                    <input placeholder="0.00" @bind="_tax" />
                    <label class="bite-label">Tip</label>
                    <input placeholder="0.00" @bind="_tip" />
                    <label class="bite-label">Delivery fee</label>
                    <input placeholder="0.00" @bind="_deliveryFee" />

                    <p class="bite-row-sub" style="margin:.25rem 0 .9rem;"><em>Payment collection (Stripe) happens per participant client-side before this step in the full build — this MVP submits without capturing payment methods yet.</em></p>
                    <button class="primary" @onclick="SubmitOrder">Place order</button>
                </div>
            }

            @if (_receipts.Any())
            {
                <div class="bite-section-title">Order summary</div>
                <div class="bite-card">
                    @foreach (var r in _receipts)
                    {
                        <div class="bite-row">
                            <div class="bite-row-main">
                                <span class="bite-row-title">@r.ParticipantName</span>
                                <span class="bite-row-sub">@(r.PaymentCaptured ? "✅ Paid" : "⏳ Pending")</span>
                            </div>
                            <span class="bite-row-price">$@r.AmountOwed.ToString("0.00")</span>
                        </div>
                    }
                    <div style="margin-top:.9rem;">
                        <button class="secondary" style="width:100%;" @onclick="DownloadReceiptPdf">⬇ Download PDF receipt</button>
                    </div>
                </div>
            }

            @if (Tokens.IsHost && _orderStatus is not null && _orderStatus != "Delivered")
            {
                <div class="bite-card">
                    <h3>Kitchen status</h3>
                    <button class="primary" @onclick="AdvanceStatus">Mark next stage →</button>
                </div>
            }

            @if (_error is not null)
            {
                <p class="bite-error">@_error</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private List<ParticipantDto> _participants = new();
    private List<MenuItemDto> _menuItems = new();
    private List<CartItemDto> _cart = new();
    private List<ReceiptDto> _receipts = new();
    private Guid? _orderId;
    private string? _orderStatus;
    private string? _error;
    private string? _reconnectBanner;

    private string _newItemName = "";
    private string _newItemPrice = "";
    private string _splitMode = "Equal";
    private string _tax = "0";
    private string _tip = "0";
    private string _deliveryFee = "0";

    private static readonly string[] StatusOrder = { "Confirmed", "Preparing", "OutForDelivery", "Delivered" };
    private Guid? _myParticipantId;

    private static string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string FriendlyStatus(string s) => s switch
    {
        "Confirmed" => "Confirmed",
        "Preparing" => "Preparing",
        "OutForDelivery" => "On the way",
        "Delivered" => "Delivered",
        _ => s
    };

    protected override async Task OnInitializedAsync()
    {
        if (Tokens.ParticipantToken is null || Tokens.SessionId != SessionId)
            return;

        _myParticipantId = Tokens.ParticipantId;
        await RefreshAllAsync();

        Hub.CartUpdated += OnCartUpdated;
        Hub.OrderStatusChanged += OnOrderStatusChanged;
        Hub.Reconnecting += () => { _reconnectBanner = "Reconnecting..."; InvokeAsync(StateHasChanged); };
        Hub.Reconnected += () => { _reconnectBanner = null; InvokeAsync(StateHasChanged); };
        Hub.ConnectionLost += () => { _reconnectBanner = "Connection lost — refresh to reconnect."; InvokeAsync(StateHasChanged); };

        await Hub.ConnectAsync(SessionId, Tokens.ParticipantToken);
    }

    private async Task RefreshAllAsync()
    {
        _participants = await Api.GetParticipantsAsync(SessionId);
        _menuItems = await Api.GetMenuItemsAsync(SessionId);
        _cart = await Api.GetCartAsync(SessionId);
    }

    private void OnCartUpdated(CartEvent evt) => InvokeAsync(async () =>
    {
        _cart = await Api.GetCartAsync(SessionId);
        StateHasChanged();
    });

    private void OnOrderStatusChanged(OrderStatusUpdate evt) => InvokeAsync(() =>
    {
        _orderId = evt.OrderId;
        _orderStatus = evt.Status;
        StateHasChanged();
    });

    private async Task AddMenuItem()
    {
        if (!decimal.TryParse(_newItemPrice, out var price) || string.IsNullOrWhiteSpace(_newItemName))
        {
            _error = "Enter a name and a valid price.";
            return;
        }

        var result = await Api.AddMenuItemAsync(SessionId, _newItemName, null, price);
        if (result is not null)
        {
            _menuItems.Add(result);
            _newItemName = "";
            _newItemPrice = "";
        }
    }

    private async Task AddToCart(Guid menuItemId) => await Api.AddCartItemAsync(SessionId, menuItemId, 1, null);

    private async Task RemoveFromCart(Guid cartItemId) => await Api.RemoveCartItemAsync(SessionId, cartItemId);

    private async Task SubmitOrder()
    {
        _error = null;
        decimal.TryParse(_tax, out var tax);
        decimal.TryParse(_tip, out var tip);
        decimal.TryParse(_deliveryFee, out var deliveryFee);

        var result = await Api.SubmitOrderAsync(SessionId, _splitMode, tax, tip, deliveryFee, new Dictionary<Guid, string>());
        if (result is null)
        {
            _error = "Couldn't submit the order.";
            return;
        }

        _orderId = result.OrderId;
        _orderStatus = result.Status;
        _receipts = result.Receipts.ToList();
    }

    private async Task DownloadReceiptPdf()
    {
        if (_orderId is null) return;
        var bytes = await Api.GetReceiptPdfAsync(SessionId, _orderId.Value);
        if (bytes is null)
        {
            _error = "Couldn't download the receipt.";
            return;
        }
        await JS.InvokeVoidAsync("biteShareDownloadFile", $"biteshare-receipt-{_orderId}.pdf", Convert.ToBase64String(bytes), "application/pdf");
    }

    private async Task AdvanceStatus()
    {
        if (_orderId is null || _orderStatus is null) return;
        var currentIndex = Array.IndexOf(StatusOrder, _orderStatus);
        if (currentIndex < 0 || currentIndex >= StatusOrder.Length - 1) return;

        await Api.UpdateOrderStatusAsync(SessionId, _orderId.Value, StatusOrder[currentIndex + 1]);
    }

    public async ValueTask DisposeAsync()
    {
        await Hub.DisposeAsync();
    }
}
