@page "/"
@inject ApiClient Api
@inject AuthTokenStore Tokens
@inject NavigationManager Nav

<PageTitle>BiteShare</PageTitle>

<div class="bite-container">
    <div class="bite-hero">
        <div class="bite-brand">
            <span class="bite-brand-mark">🍱</span>
            BiteShare
        </div>
        <h1>Order together, split it fairly.</h1>
        <p>Host a group order for the table or join one with a code — everyone adds their own food to one shared cart.</p>
    </div>

    <div class="bite-body">
        <div class="bite-tabs">
            <button class="@(_tab == Tab.Join ? "active" : "")" @onclick="() => _tab = Tab.Join">Join with a code</button>
            <button class="@(_tab == Tab.Host ? "active" : "")" @onclick="() => _tab = Tab.Host">Host a session</button>
        </div>

        @if (_tab == Tab.Host)
        {
            <div class="bite-card">
                @if (Tokens.IdentityToken is null)
                {
                    <h3>@(_authMode == AuthMode.Login ? "Sign In" : "Sign Up")</h3>

                    @if (_authMode == AuthMode.Register)
                    {
                        <label class="bite-label">Name</label>
                        <input placeholder="John Doe" @bind="_displayName" />
                    }

                    <label class="bite-label">Email address</label>
                    <input placeholder="johndoe123@gmail.com" @bind="_email" />

                    <label class="bite-label">Password</label>
                    <input placeholder="••••••••" type="password" @bind="_password" />

                    <div style="margin-top:.5rem;">
                        <button class="primary" @onclick="SubmitAuth">@(_authMode == AuthMode.Login ? "Sign In" : "Sign Up")</button>
                    </div>
                    <button class="bite-link-btn" @onclick="ToggleAuthMode">
                        @(_authMode == AuthMode.Login ? "Don't have an account? Sign Up" : "Already have an account? Sign In")
                    </button>
                }
                else
                {
                    <div class="bite-row" style="border:none; padding-bottom:.9rem;">
                        <div class="bite-row-main">
                            <span class="bite-row-sub">Signed in as</span>
                            <span class="bite-row-title">@Tokens.IdentityDisplayName</span>
                        </div>
                        <div class="bite-avatar-circle host">@Initials(Tokens.IdentityDisplayName)</div>
                    </div>

                    <h3>Start a new session</h3>
                    <label class="bite-label">Session name</label>
                    <input placeholder="e.g. Friday office lunch" @bind="_sessionName" />
                    <div style="margin-top:.3rem;">
                        <button class="primary" @onclick="CreateSession">Create session</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bite-card">
                <h3>Join a session</h3>
                <p class="bite-row-sub" style="margin:-.4rem 0 .75rem;">Enter the code your host shared with the table.</p>
                <label class="bite-label">Join code</label>
                <input placeholder="e.g. 7F3K2Q" @bind="_joinCode" style="text-transform:uppercase;" />
                <label class="bite-label">Your name</label>
                <input placeholder="John Doe" @bind="_displayName" />
                <div style="margin-top:.3rem;">
                    <button class="primary" @onclick="JoinAsGuest">Join session</button>
                </div>
            </div>
        }

        @if (_error is not null)
        {
            <p class="bite-error">@_error</p>
        }

        <div class="bite-section-title" style="margin-top:2rem;">How it works</div>
        <div class="bite-card">
            <div class="bite-row">
                <div class="bite-row-main">
                    <span class="bite-row-title">🎉 1. Host creates a session</span>
                    <span class="bite-row-sub">Get a shareable join code for the table</span>
                </div>
            </div>
            <div class="bite-row">
                <div class="bite-row-main">
                    <span class="bite-row-title">🛒 2. Everyone adds their food</span>
                    <span class="bite-row-sub">Guests join and order into one shared cart</span>
                </div>
            </div>
            <div class="bite-row">
                <div class="bite-row-main">
                    <span class="bite-row-title">🧾 3. The bill splits itself</span>
                    <span class="bite-row-sub">Equal or per-item — everyone gets their own receipt</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private enum Tab { Host, Join }
    private enum AuthMode { Login, Register }

    private Tab _tab = Tab.Join;
    private AuthMode _authMode = AuthMode.Register;
    private string _email = "";
    private string _password = "";
    private string _displayName = "";
    private string _sessionName = "";
    private string _joinCode = "";
    private string? _error;

    private static string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private void ToggleAuthMode() => _authMode = _authMode == AuthMode.Login ? AuthMode.Register : AuthMode.Login;

    private async Task SubmitAuth()
    {
        _error = null;
        var result = _authMode == AuthMode.Login
            ? await Api.LoginAsync(_email, _password)
            : await Api.RegisterAsync(_email, _password, _displayName);

        if (result is null)
        {
            _error = "Couldn't sign in — check your details and try again.";
            return;
        }

        await Tokens.SetIdentityAsync(result.Token, result.DisplayName);
    }

    private async Task CreateSession()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_sessionName))
        {
            _error = "Give the session a name.";
            return;
        }

        var result = await Api.CreateSessionAsync(_sessionName, null);
        if (result is null)
        {
            _error = "Couldn't create the session.";
            return;
        }

        await Tokens.SetParticipantAsync(result.ParticipantToken, result.Session.Id, result.ParticipantId, isHost: true);
        Nav.NavigateTo($"/session/{result.Session.Id}");
    }

    private async Task JoinAsGuest()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_joinCode) || string.IsNullOrWhiteSpace(_displayName))
        {
            _error = "Enter both a join code and your name.";
            return;
        }

        var result = await Api.GuestJoinAsync(_joinCode.Trim().ToUpperInvariant(), _displayName);
        if (result is null)
        {
            _error = "Couldn't find that session — check the code.";
            return;
        }

        await Tokens.SetParticipantAsync(result.GuestToken, result.SessionId, result.ParticipantId, isHost: false);
        Nav.NavigateTo($"/session/{result.SessionId}");
    }
}
