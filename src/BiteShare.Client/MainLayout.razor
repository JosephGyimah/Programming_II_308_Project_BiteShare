@inherits LayoutComponentBase
@implements IDisposable
@inject AuthTokenStore Tokens
@inject NavigationManager Nav

<div class="page @PageWidthClass">
    <main>
        @if (!IsSessionPage)
        {
            <nav class="bite-nav">
                <div class="bite-nav-inner">
                    <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                    <NavLink href="join">Join</NavLink>
                    @if (!Tokens.IsLoggedIn)
                    {
                        <NavLink href="signup">Sign up</NavLink>
                    }
                    else
                    {
                        <NavLink href="my-sessions">My Sessions</NavLink>
                        <button class="bite-link-btn bite-nav-spacer" @onclick="LogOut">Log out</button>
                    }
                </div>
            </nav>
        }
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri);

    private bool IsSessionPage => CurrentPath.StartsWith("session/", StringComparison.OrdinalIgnoreCase);

    // Routes that show lists or a side-by-side layout get the roomier desktop
    // column; the auth/short-form pages stay a narrow, readable single column.
    private string PageWidthClass =>
        IsSessionPage || CurrentPath.StartsWith("my-sessions", StringComparison.OrdinalIgnoreCase)
            ? "page-wide"
            : "";

    protected override async Task OnInitializedAsync()
    {
        Tokens.OnChange += Refresh;
        Nav.LocationChanged += OnLocationChanged;
        await Tokens.LoadFromStorageAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Refresh();

    private async Task LogOut()
    {
        await Tokens.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Tokens.OnChange -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
